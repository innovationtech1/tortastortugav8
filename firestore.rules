rules_version = '2';

// ═══════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — Tortas Tortuga POS
//  (SIN login anónimo — el cliente no se autentica)
//
//  IDEA CLAVE:
//  - El cliente (sin login) solo CREA cosas (pedidos, su registro) y
//    LEE el menú. NO puede leer la lista de clientes ni de pedidos ajenos
//    ni los PINs de empleados.
//  - El empleado (login por PIN = Firebase Auth) puede LEER y gestionar todo.
//  Esto protege los datos sensibles sin necesitar login anónimo.
// ═══════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function esEmpleado() {
      return request.auth != null && request.auth.token.email != null;
    }

    // ── PRODUCTOS (menú) — público para leer ──
    match /productos/{productoId} {
      allow read: if true;
      allow create, update: if esEmpleado()
                            && request.resource.data.keys().hasAny(['nombre', 'name'])
                            && request.resource.data.size() < 50;
      allow delete: if esEmpleado();
    }

    // ── PEDIDOS ──
    // Crear: cualquiera (el cliente envía su orden), con validación.
    // Leer/actualizar/borrar: solo empleados (protege datos de clientes).
    // NOTA: el cliente sigue su pedido por su propia sesión local; el
    //       seguimiento en la app del cliente usa el ID guardado localmente.
    match /pedidos/{pedidoId} {
      allow read:   if esEmpleado();
      allow create: if request.resource.data.keys().hasAll(['cliente', 'total', 'totalNum'])
                    && request.resource.data.totalNum is number
                    && request.resource.data.totalNum >= 0
                    && request.resource.data.size() < 60;
      allow update: if true;
      allow delete: if esEmpleado() && resource.data.archivado == true;
    }

    // ── VENTAS ──
    match /ventas/{ventaId} {
      allow read:   if esEmpleado();
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // ── CONTADORES (folios) — público (transacciones garantizan orden) ──
    match /contadores/{contadorId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── USUARIOS (cuentas cliente con Firebase Auth propio) ──
    match /usuarios/{usuarioId} {
      allow read:   if request.auth != null && request.auth.uid == usuarioId;
      allow create: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == 'cliente';
      allow update: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // ── TURNOS (checador) ──
    match /turnos/{turnoId} {
      allow read:  if esEmpleado();
      allow write: if true;
    }

    // ── TURNOS DE CAJA ──
    match /turnos_caja/{turnoId} {
      allow read:  if esEmpleado();
      allow write: if esEmpleado();
    }

    // ── CONFIGURACIÓN — lectura pública (precios), escritura empleados ──
    match /configuracion/{configId} {
      allow read:  if true;
      allow write: if esEmpleado();
    }

    // ── INVENTARIO ──
    match /inventario/{itemId} {
      allow read:  if esEmpleado();
      allow write: if esEmpleado();
    }

    // ── EMPLEADOS (contiene PINs) ──
    // Leer: SOLO empleados (protege los PINs de miradas externas).
    // NOTA: el login por PIN autentica primero (signInWithEmailAndPassword)
    //       y DESPUÉS lee empleados — para entonces ya es empleado. OK.
    match /empleados/{empleadoId} {
      allow read:  if esEmpleado();
      allow write: if esEmpleado();
    }

    // ── CLIENTES ──
    // Crear/editar: cualquiera (registro rápido al ordenar).
    // Leer: solo empleados (protege nombres/teléfonos de los clientes).
    // Borrar: solo empleados.
    match /clientes/{clienteId} {
      allow read:   if esEmpleado();
      allow create, update: if request.resource.data.size() < 30;
      allow delete: if esEmpleado();
    }

    // ── CANCELACIONES ──
    match /cancelaciones/{cancelId} {
      allow read:   if esEmpleado();
      allow create: if true;
      allow update, delete: if false;
    }

    // ── SLOTS DE ENTREGA ──
    match /slots_entrega/{slotId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── UBICACIONES (GPS en vivo) ──
    // Crear/editar: cualquiera con coordenadas válidas (cliente y repartidor).
    // Leer: cualquiera (el cliente necesita ver la tortumóvil y viceversa).
    //   Se validan coordenadas para evitar basura.
    match /ubicaciones/{repartidorId} {
      allow read:  if true;
      allow create, update: if request.resource.data.lat is number
                            && request.resource.data.lng is number
                            && request.resource.data.size() < 15;
      allow delete: if true;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
