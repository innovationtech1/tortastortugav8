rules_version = '2';

// ═══════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — Tortas Tortuga POS
//  Copia este contenido en:
//  Firebase Console → Firestore Database → Reglas → Publicar
//
//  NOTA: La app usa login por PIN (empleados/gerente) que NO genera
//  sesión de Firebase Auth. Por eso varias colecciones siguen abiertas
//  a escritura, pero ahora con VALIDACIONES que evitan datos basura o
//  maliciosos. Para cerrar del todo se necesita migrar a Firebase Auth.
//
//  ── FASE 1 (endurecimiento sin auth) ──
//   • clientes/ubicaciones: 'delete' cerrado. pedidos update: sin totales
//     negativos. clientes create/update: tamaño estricto.
//
//  ── FASE 2 (identidad real del equipo vía Firebase Auth) ──
//   • Helpers esStaff()/esGerente() sobre staff/{uid} (uid = Firebase Auth).
//   • empleados: LECTURA cerrada a staff/propio → los PINs dejan de ser
//     públicos. Escritura a gerente o al propio empleado.
//   • clientes: LECTURA cerrada a staff (protege nombre/teléfono).
//   ⚠️ PUBLICAR SOLO cuando: (1) el gerente esté en staff/{uid}, y (2) todos
//     los empleados estén migrados (ver pages/migrar-accesos.html). Si no,
//     un empleado sin cuenta Firebase quedaría fuera.
//
//  ── PENDIENTE FASE 2b ──
//   • pedidos: LECTURA sigue pública (el seguimiento del cliente la necesita
//     y el cliente por teléfono/invitado aún no tiene identidad Firebase).
// ═══════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ HELPERS DE IDENTIDAD DEL EQUIPO (Fase 2) ═══
    // El rol de cada empleado vive en staff/{uid}, donde uid es el UID de
    // Firebase Auth. Las reglas NO pueden hacer queries, solo get()/exists()
    // por id de documento — por eso el mapeo es uid -> rol.
    // (Estos helpers YA quedan disponibles; se APLICAN a las colecciones
    //  existentes en un paso posterior, para no romper la app mientras se
    //  migran las cuentas del equipo.)
    function estaAutenticado() {
      return request.auth != null;
    }
    function esStaff() {
      return request.auth != null
             && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function rolStaff() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.rol;
    }
    function esGerente() {
      return esStaff() && (rolStaff() == 'gerente' || rolStaff() == 'supervisor');
    }

    // ── STAFF (mapeo uid -> rol del empleado; fuente de verdad de permisos) ──
    // Lectura: el propio empleado (para saber su rol al entrar) o cualquier
    //   staff (para paneles de gestión).
    // Escritura: solo gerente/supervisor (asignar/cambiar roles). El PRIMER
    //   gerente se crea a mano en la consola (bootstrap), lo que habilita al
    //   resto. Un empleado NUNCA puede auto-asignarse un rol.
    match /staff/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || esStaff());
      allow create: if esGerente();
      allow update: if esGerente();
      allow delete: if esGerente();
    }

    // ── PRODUCTOS ──
    // Lectura pública (el menú debe verse sin login).
    // Escritura pública (gerente edita en modo PIN), pero validando que
    // el producto tenga al menos nombre y un precio numérico — evita
    // inyectar documentos basura en el menú.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(['nombre', 'name'])
                            && request.resource.data.size() < 50;
      allow delete: if true;
    }

    // ── PEDIDOS ──
    // Crear: cualquiera puede enviar una orden, PERO debe traer los
    // campos esenciales y un total numérico >= 0 (evita pedidos basura
    // o con totales negativos/manipulados).
    // Leer/actualizar: cocina y admin necesitan acceso (modo PIN).
    // Borrar: SOLO si ya está archivado (nunca un pedido activo).
    match /pedidos/{pedidoId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['cliente', 'total', 'totalNum'])
                    && request.resource.data.totalNum is number
                    && request.resource.data.totalNum >= 0
                    && request.resource.data.size() < 60;
      // Update sigue abierto (staff por PIN, sin auth), PERO se bloquea
      // manipular el total a valores negativos o no numéricos. Los flujos
      // legítimos (cambiar estado, cobro, asignar repartidor) mantienen
      // totalNum >= 0, así que no se ven afectados.
      allow update: if !('totalNum' in request.resource.data)
                    || (request.resource.data.totalNum is number
                        && request.resource.data.totalNum >= 0);
      allow delete: if resource.data.archivado == true;
    }

    // ── VENTAS (registro contable permanente) ──
    // Público para crear (modo PIN), nunca editable ni borrable.
    match /ventas/{ventaId} {
      allow read:   if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // ── CONTADORES (folios diarios) ──
    // Necesario para el número secuencial de orden #001, #002...
    // (la consistencia la garantizan las transacciones atómicas).
    match /contadores/{contadorId} {
      allow read: if true;
      allow write: if true;
    }

    // ── USUARIOS (cuentas de cliente con email+contraseña, Firebase Auth) ──
    // Cada cliente autenticado solo puede leer/escribir SU PROPIO documento.
    // Nunca puede auto-asignarse un rol distinto de 'cliente'.
    match /usuarios/{usuarioId} {
      allow read:  if request.auth != null && request.auth.uid == usuarioId;
      allow create: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == 'cliente';
      allow update: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // ── TURNOS (checador individual: entrada/salida por empleado) ──
    // Público a propósito: el checador funciona sin Firebase Auth.
    match /turnos/{turnoId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── TURNOS DE CAJA ──
    // Solo autenticados (corte de caja).
    match /turnos_caja/{turnoId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── CONFIGURACIÓN (impuestos, propinas, etc) ──
    // Lectura pública; escritura solo autenticados.
    match /configuracion/{configId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── INVENTARIO ──
    match /inventario/{itemId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── EMPLEADOS ──  (FASE 2: cerrado)
    // Los docs se guardan con id = UID de Firebase Auth (empleadoId == uid).
    // Leer: solo staff (mata la exposición pública de PINs) o el propio
    //   empleado su documento. Ya NO es público.
    // Crear/editar: gerente/supervisor, o el propio empleado su documento
    //   (crearEmpAdmin escribe empleados/{uid} estando autenticado como ese
    //   uid recién creado; el cambio de PIN propio edita empleados/{uid}).
    // Borrar: solo gerente/supervisor.
    match /empleados/{empleadoId} {
      allow read:   if esStaff() || (request.auth != null && request.auth.uid == empleadoId);
      allow create, update: if esGerente() || (request.auth != null && request.auth.uid == empleadoId);
      allow delete: if esGerente();
    }

    // ── CLIENTES (login rápido por teléfono) ──  (FASE 2: lectura cerrada)
    // Lectura: solo staff (los clientes tienen nombre y teléfono = PII).
    //   entrar.html ya NO lee esta colección (escribe con increment).
    // Escritura: pública a propósito (el login por teléfono guarda el
    //   cliente SIN autenticación), pero con forma pequeña y validada.
    match /clientes/{clienteId} {
      allow read:  if esStaff();
      allow create, update: if request.resource.data.size() < 20;
      // La app NUNCA borra clientes → cerrado.
      allow delete: if false;
    }

    // ── SLOTS DE ENTREGA (sistema de colas por zona/horario) ──
    // Público como pedidos/turnos: la consistencia (no superposiciones)
    // la garantizan las transacciones atómicas, no las reglas.
    match /slots_entrega/{slotId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── UBICACIONES DE TORTUMÓVILES (GPS en vivo de repartidores) ──
    // El repartidor comparte su posición mientras usa Mi Ruta; el admin la
    // lee para el mapa en vivo. Público (modo PIN), validando que traiga
    // coordenadas numéricas y sea un documento pequeño.
    match /ubicaciones/{repartidorId} {
      allow read:  if true;
      allow create, update: if request.resource.data.lat is number
                            && request.resource.data.lng is number
                            && request.resource.data.size() < 15;
      // La app NUNCA borra ubicaciones → cerrado (antes: if true).
      allow delete: if false;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
