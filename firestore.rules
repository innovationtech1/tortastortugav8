rules_version = '2';

// ═══════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — Tortas Tortuga POS (ENDURECIDAS)
//  Copia este contenido en:
//  Firebase Console -> Firestore Database -> Reglas -> Publicar
//
//  ESTRATEGIA:
//  - El menú (productos) es público: se ve sin login.
//  - Todo lo sensible (pedidos, clientes, ubicaciones, empleados)
//    exige estar AUTENTICADO. El cliente recibe un pase ANÓNIMO
//    automático; el empleado usa su login por PIN (Firebase Auth).
//  - Lo más delicado (editar empleados, config, ventas) exige un
//    empleado REAL (no anónimo): auth con email verificado interno.
//
//  IMPORTANTE: requiere activar "Anónimo" en Authentication -> Sign-in.
// ═══════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Ayudante: ¿está autenticado (aunque sea anónimo)?
    function autenticado() {
      return request.auth != null;
    }
    // Ayudante: ¿es un empleado real (login por PIN = email interno)?
    // Los anónimos NO tienen email; los empleados sí (emp-xxx@tortuga.local).
    function esEmpleado() {
      return request.auth != null && request.auth.token.email != null;
    }

    // ── PRODUCTOS (menú) ──
    // Lectura PÚBLICA (el menú se ve sin login).
    // Escritura: solo empleados reales, validando datos.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update: if esEmpleado()
                            && request.resource.data.keys().hasAny(['nombre', 'name'])
                            && request.resource.data.size() < 50;
      allow delete: if esEmpleado();
    }

    // ── PEDIDOS ──
    // Leer: solo autenticados (protege datos de clientes).
    // Crear: autenticado, con campos y total válidos.
    // Actualizar: autenticado (cocina/repartidor/cliente comparte ubicación).
    // Borrar: solo empleados y solo si está archivado.
    match /pedidos/{pedidoId} {
      allow read:   if autenticado();
      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(['cliente', 'total', 'totalNum'])
                    && request.resource.data.totalNum is number
                    && request.resource.data.totalNum >= 0
                    && request.resource.data.size() < 60;
      allow update: if autenticado();
      allow delete: if esEmpleado() && resource.data.archivado == true;
    }

    // ── VENTAS (registro contable permanente) ──
    // Crear: solo empleados. Nunca editable ni borrable.
    match /ventas/{ventaId} {
      allow read:   if esEmpleado();
      allow create: if esEmpleado();
      allow update: if false;
      allow delete: if false;
    }

    // ── CONTADORES (folios diarios) ──
    // Autenticados (la consistencia la dan las transacciones atómicas).
    match /contadores/{contadorId} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // ── USUARIOS (cuentas cliente con Firebase Auth propio) ──
    match /usuarios/{usuarioId} {
      allow read:   if request.auth != null && request.auth.uid == usuarioId;
      allow create: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == 'cliente';
      allow update: if request.auth != null && request.auth.uid == usuarioId
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // ── TURNOS (checador entrada/salida) ──
    match /turnos/{turnoId} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // ── TURNOS DE CAJA ──
    match /turnos_caja/{turnoId} {
      allow read:  if esEmpleado();
      allow write: if esEmpleado();
    }

    // ── CONFIGURACIÓN (impuestos, propinas) ──
    // Lectura pública (se necesita para calcular precios sin login).
    // Escritura: solo empleados reales.
    match /configuracion/{configId} {
      allow read:  if true;
      allow write: if esEmpleado();
    }

    // ── INVENTARIO ──
    match /inventario/{itemId} {
      allow read:  if autenticado();
      allow write: if esEmpleado();
    }

    // ── EMPLEADOS (contiene PINs — proteger lectura) ──
    // Leer: solo autenticados (evita exponer PINs a cualquiera).
    // Escribir: solo empleados reales.
    match /empleados/{empleadoId} {
      allow read:  if autenticado();
      allow write: if esEmpleado();
    }

    // ── CLIENTES (login rápido por teléfono) ──
    // Leer: solo autenticados (protege nombres/teléfonos).
    // Crear/editar: autenticado, documento pequeño.
    // Borrar: solo empleados.
    match /clientes/{clienteId} {
      allow read:   if autenticado();
      allow create, update: if autenticado() && request.resource.data.size() < 30;
      allow delete: if esEmpleado();
    }

    // ── CANCELACIONES (motivos de pedidos cancelados) ──
    match /cancelaciones/{cancelId} {
      allow read:   if esEmpleado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // ── SLOTS DE ENTREGA (colas por zona/horario) ──
    match /slots_entrega/{slotId} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // ── UBICACIONES (GPS en vivo de repartidores/tortumóviles) ──
    // Leer: autenticados (cliente ve la tortumóvil; admin ve repartidores).
    // Escribir: autenticado, con coordenadas numéricas válidas.
    match /ubicaciones/{repartidorId} {
      allow read:  if autenticado();
      allow create, update: if autenticado()
                            && request.resource.data.lat is number
                            && request.resource.data.lng is number
                            && request.resource.data.size() < 15;
      allow delete: if autenticado();
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
